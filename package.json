{
  "name": "naeringsfordeling",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.sw.json && tsc -p tsconfig.server.json",
    "build-db": "tsx scripts/build-db.ts",
    "build-national-db": "tsx scripts/build-national-db.ts",
    "build-region-db": "tsx scripts/build-region-db.ts",
    "build-all-fylker": "tsx scripts/build-all-regions.ts --fylker",
    "build-national-from-fylker": "tsx scripts/build-national-from-fylker.ts",
    "build-all-kommuner": "tsx scripts/build-all-regions.ts --kommuner",
    "build-all-regions": "tsx scripts/build-all-regions.ts",
    "build-db:dev": "tsx scripts/build-db.ts --dev --fresh",
    "sync": "tsx scripts/sync.ts",
    "sync:full": "tsx scripts/sync.ts --full",
    "sync:backfill": "tsx scripts/sync.ts --backfill",
    "sync:backfill:metadata": "tsx scripts/sync.ts --backfill --regeocode-metadata",
    "sync:dev": "tsx scripts/sync.ts --dev --geocode-limit=2000",
    "sync:geocode": "tsx scripts/sync.ts --geocode-only",
    "server": "tsx server/index.ts",
    "server:vestland": "DATABASE_PATH=data/regions/fylker/46-vestland.db tsx server/index.ts",
    "server:norway": "DATABASE_PATH=data/norway.db tsx server/index.ts",
    "export-points": "tsx scripts/export-point-tiles.ts",
    "export-map-tiles": "tsx scripts/export-map-tiles.ts",
    "export-district-colors": "tsx scripts/export-district-colors.ts",
    "rebuild-org-tiles": "tsx scripts/rebuild-org-tiles.ts",
    "rebuild-org-tiles:norway": "DATABASE_PATH=data/norway.db tsx scripts/rebuild-org-tiles.ts",
    "export-map-tiles:norway": "DATABASE_PATH=data/norway.db tsx scripts/export-map-tiles.ts",
    "export-vector-tiles": "tsx scripts/export-map-tiles.ts",
    "download-db": "bash scripts/download-db.sh",
    "download-kommuner": "bash scripts/download-kommuner.sh",
    "download-grunnkretser": "bash scripts/download-grunnkretser.sh",
    "download-points": "bash scripts/download-points.sh",
    "export-static-api": "NODE_OPTIONS='--max-old-space-size=6144' tsx scripts/export-static-api.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "yarn lint && yarn check && yarn test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,svelte}": [
      "eslint --fix"
    ],
    "*.{ts,svelte,json,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.13.2",
    "@types/serviceworker": "^0.0.200",
    "@types/stream-json": "^1.7.8",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "better-sqlite3": "^12.11.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "stream-json": "^3.5.0",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@maplibre/maplibre-gl-leaflet": "^0.1.3",
    "hono": "^4.12.30",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.4.1",
    "polyclip-ts": "^0.16.8"
  }
}
