# Server
PORT=3001
DATABASE_PATH=data/organizations.db

# Build / sync scripts
NATIONAL_DB_PATH=data/norway.db
REGIONS_OUTPUT_DIR=data/regions
REFERENCE_CACHE_DIR=data/cache/reference
KARTVERKET_CACHE_DIR=data/cache/reference/kartverket
BUILD_DB_MAX_ROUNDS=10000
BUILD_DB_MAX_GEOCODE_ADDRESSES=

# Rate limiting (scripts)
BRREG_PAGE_DELAY_MS=250
BRREG_ENTITY_DELAY_MS=150
SYNC_GEOCODE_CONCURRENCY=3
SYNC_GEOCODE_LIMIT=5000
GEOCODE_DELAY_MS=200
GEOCODE_BATCH_PAUSE_MS=2000
API_MAX_RETRIES=5
API_RETRY_BASE_MS=1000

# Export scripts
POINTS_OUTPUT_DIR=public/data/points
STATIC_API_DIR=public/data/api
DISTRICTS_OUTPUT_DIR=public/data/districts
SKIP_DISTRICT_COLORS=0
DISTRICTS_SKIP_EXPORT=0

# Vite (GitHub Pages deployment)
GITHUB_PAGES=false
VITE_BASE=/
